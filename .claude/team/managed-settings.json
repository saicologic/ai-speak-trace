{
  "permissions": {
    "deny": [
      "Bash(/bin/bash *)",
      "Bash(/bin/sh *)",
      "Bash(/usr/bin/git *)",
      "Bash(bash -c *)",
      "Bash(bash -lc *)",
      "Bash(bash)",
      "Bash(eval *)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete *)",
      "Bash(sh -c *)",
      "Bash(sh -lc *)",
      "Bash(sh)",
      "Bash(sudo *)",
      "Bash(zsh -c *)",
      "Read(//**/.env*)",
      "Read(~/Library/Application Support/io.github.saicologic.ai-speak-trace/data/**)",
      "Read(~/Library/Application Support/io.github.saicologic.ai-speak-trace/settings.json)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "/opt/claude-code-team/bin/github.sh *",
      "/opt/claude-code-team/bin/cr-review.sh",
      "/opt/claude-code-team/bin/cr-review.sh *",
      "/opt/claude-code-team/bin/wait-pr-checks.sh *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ],
      "deniedDomains": [
        "github.com"
      ],
      "allowManagedDomainsOnly": true
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-code-team/bin/watch-pr-checks.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
