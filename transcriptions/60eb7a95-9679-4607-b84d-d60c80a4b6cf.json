          "type": "word",
          "speakerId": "speaker_1"
        },
        {
          "text": "元々二人はアメリカで研究をやっていたんですけれども、",
          "start": 84.9,
          "end": 88.38,
          "type": "word",
          "speakerId": "speaker_1"
        },
        {
