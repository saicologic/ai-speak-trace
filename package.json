{
  "scripts": {
    "dev": "npm run kill && concurrently -n backend,tauri -c blue,magenta \"cd backend && npm run start:dev\" \"tauri dev\"",
    "build": "npm run pkg:backend && tauri build",
    "tauri": "tauri",
    "kill": ". ./.env 2>/dev/null || true; lsof -ti:${BACKEND_PORT:-3100} | xargs kill -9 || true",
    "pkg:backend": "cd backend && npm run pkg:mac-arm64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "concurrently": "^9.2.1"
  }
}
